page {
  background: var(--color-bg);
}

.header-card {
  background: linear-gradient(135deg, rgba(15,76,75,0.08), rgba(148,163,184,0.06));
  border: 2rpx solid rgba(148,163,184,0.55);
  border-radius: var(--radius-lg);
  padding: var(--space-5);
  margin-bottom: var(--space-4);
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-3);
}

.badge {
  font-size: var(--font-xs);
  font-weight: var(--font-bold);
  letter-spacing: 0.18em;
  color: var(--color-teal);
  text-transform: uppercase;
}

.chip {
  font-size: var(--font-xs);
  font-weight: var(--font-semibold);
  padding: var(--space-1) var(--space-3);
  border-radius: var(--radius-full);
  border: 2rpx solid var(--color-teal);
  color: var(--color-teal);
}

.header-title {
  display: block;
  font-size: var(--font-xl);
  font-weight: var(--font-bold);
  line-height: 1.3;
  color: var(--color-text-primary);
  margin-bottom: var(--space-2);
}

.header-desc {
  display: block;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.55;
}

.tools-list {
  margin-bottom: var(--space-4);
}

.section-title {
  display: block;
  font-size: var(--font-lg);
  font-weight: var(--font-bold);
  color: var(--color-text-primary);
  margin-bottom: var(--space-2);
}

.section-desc {
  display: block;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  margin-bottom: var(--space-4);
}

.tool-card {
  background: var(--color-surface);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-5);
  margin-bottom: var(--space-4);
  transition: all 200ms ease;
}

.tool-card--pressed {
  transform: scale(0.98);
  border-color: var(--color-teal);
  box-shadow: var(--shadow-md);
}

.tool-card-header {
  display: flex;
  align-items: center;
  gap: var(--space-4);
  margin-bottom: var(--space-4);
}

.tool-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 2rpx solid var(--color-border);
  flex-shrink: 0;
  background: var(--color-surface);
}

.tool-icon-text {
  font-size: var(--font-2xl);
  font-weight: var(--font-bold);
  color: var(--color-teal);
}

.tool-info {
  flex: 1;
  min-width: 0;
}

.tool-name {
  display: block;
  font-size: var(--font-lg);
  font-weight: var(--font-bold);
  line-height: 1.2;
  margin-bottom: var(--space-2);
  color: var(--color-text-primary);
}

.tool-desc {
  display: block;
  font-size: var(--font-base);
  color: var(--color-text-secondary);
  margin-bottom: var(--space-1);
}

.tool-brief {
  display: block;
  font-size: var(--font-sm);
  color: var(--color-text-muted);
}

.arrow-icon {
  font-size: var(--font-xl);
  color: var(--color-teal);
  flex-shrink: 0;
}

.tool-card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--space-3);
}

.chip-tag {
  font-size: var(--font-xs);
  font-weight: var(--font-semibold);
  padding: var(--space-1) var(--space-3);
  border-radius: var(--radius-full);
  color: var(--color-teal);
  background: var(--color-teal-light);
  border: 2rpx solid rgba(15,76,75,0.2);
}

.enter-text {
  font-size: var(--font-sm);
  font-weight: var(--font-bold);
  color: var(--color-teal);
}

.footer-note {
  background: var(--color-surface);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
}

.footer-text {
  display: block;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}
