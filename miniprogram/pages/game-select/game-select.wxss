page {
  background: var(--color-bg);
}

.home-shell {
  gap: var(--space-6);
  background:
    radial-gradient(ellipse 120% 60% at 50% 0%, rgba(201, 169, 110, 0.12), transparent 60%),
    radial-gradient(ellipse 80% 40% at 80% 10%, rgba(15, 76, 75, 0.06), transparent 50%),
    var(--color-bg);
}

/* ── Hero ── */
.hero {
  padding: var(--space-6) 4rpx var(--space-4);
}

.title {
  display: block;
  font-size: var(--font-3xl);
  font-weight: var(--font-bold);
  color: var(--color-text-primary);
  letter-spacing: 0.04em;
  line-height: 1.2;
}

.title::after {
  content: '';
  display: block;
  width: 60rpx;
  height: 4rpx;
  background: var(--color-accent);
  border-radius: var(--radius-full);
  margin-top: var(--space-4);
}

.subtitle {
  margin-top: var(--space-4);
  display: block;
  font-size: var(--font-base);
  color: var(--color-text-secondary);
  line-height: 1.6;
}

/* ── Game Grid ── */
.game-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-8);
  padding: var(--space-2) 0;
}

.game-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-3);
  flex: 1 1 calc(50% - var(--space-8) / 2);
  min-width: 0;
  padding: var(--space-8) var(--space-4) var(--space-6);
  background: var(--color-surface);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  transition: transform 150ms ease, box-shadow 150ms ease, border-color 150ms ease;
  overflow: hidden;
  position: relative;
}

.game-card--pressed {
  transform: scale(0.97);
  border-color: var(--color-accent);
  box-shadow: 0 4rpx 16rpx rgba(201, 169, 110, 0.15);
}

.game-card--disabled {
  opacity: 0.55;
}

.game-card--disabled-pressed {
  /* no visual change on press for disabled card */
}

.game-icon {
  width: 112rpx;
  height: 112rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  background: var(--color-bg-warm);
  flex-shrink: 0;
}

.avalon-icon {
  background: rgba(45, 122, 95, 0.1);
}

.sgs-icon {
  background: rgba(139, 69, 19, 0.1);
}

.game-name {
  font-size: var(--font-lg);
  font-weight: var(--font-bold);
  color: var(--color-text-primary);
  text-align: center;
}

.game-desc {
  font-size: var(--font-xs);
  color: var(--color-text-muted);
  text-align: center;
  line-height: 1.4;
}

/* ── Coming-soon overlay ── */
.game-card--disabled .game-desc {
  color: var(--color-text-muted);
}

