page {
  background: var(--color-bg);
}

.home-shell {
  gap: var(--space-6);
  background:
    radial-gradient(ellipse 120% 60% at 50% 0%, rgba(201, 169, 110, 0.12), transparent 60%),
    radial-gradient(ellipse 80% 40% at 80% 10%, rgba(15, 76, 75, 0.06), transparent 50%),
    var(--color-bg);
}

.hero {
  padding: var(--space-6) 4rpx var(--space-4);
}

.title {
  display: block;
  font-size: var(--font-3xl);
  font-weight: var(--font-bold);
  color: var(--color-text-primary);
  letter-spacing: 0.04em;
  line-height: 1.2;
}

.title::after {
  content: '';
  display: block;
  width: 60rpx;
  height: 4rpx;
  background: var(--color-accent);
  border-radius: var(--radius-full);
  margin-top: var(--space-4);
}

.subtitle {
  margin-top: var(--space-4);
  display: block;
  font-size: var(--font-base);
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.game-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-5);
  padding: var(--space-4);
}

.game-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-6) var(--space-4);
  background: var(--color-surface);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  cursor: pointer;
}

.game-card:active {
  transform: scale(0.97);
  border-color: var(--color-accent);
  box-shadow: 0 4rpx 16rpx rgba(201, 169, 110, 0.15);
}

.game-card--disabled {
  opacity: 0.55;
  cursor: default;
}

.game-card--disabled:active {
  transform: none;
  border-color: var(--color-border);
  box-shadow: none;
}

.game-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  background: var(--color-bg-warm);
}

.avalon-icon {
  background: rgba(45, 122, 95, 0.1);
}

.sgs-icon {
  background: rgba(139, 69, 19, 0.1);
}

.game-name {
  font-size: var(--font-xl);
  font-weight: var(--font-bold);
  color: var(--color-text-primary);
}

.game-desc {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}
