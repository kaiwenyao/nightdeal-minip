<navigation-bar title="选择游戏" back="{{false}}" color="black" background="#FFF"></navigation-bar>
<scroll-view class="page-shell home-shell" scroll-y type="list">
  <view class="hero">
    <text class="title">选择游戏</text>
    <view class="title-rule"></view>
    <text class="subtitle">请选择你要进行的桌游</text>
  </view>

  <view class="game-grid">
    <view class="game-card game-card--first" hover-class="game-card--pressed" bind:tap="handleSelectSgs">
      <view class="game-icon sgs-icon">杀</view>
      <text class="game-name">三国杀</text>
      <text class="game-desc">2-8人 身份推理</text>
    </view>

    <view class="game-card" hover-class="game-card--pressed" bind:tap="handleSelectAvalon">
      <view class="game-icon avalon-icon">A</view>
      <text class="game-name">阿瓦隆</text>
      <text class="game-desc">5-10人 身份分配</text>
    </view>
  </view>
</scroll-view>
