<navigation-bar title="选择游戏" back="{{true}}" color="black" background="#FFF"></navigation-bar>
<view class="page-shell home-shell">
  <view class="hero">
    <text class="title">选择游戏</text>
    <text class="subtitle">请选择你要进行的桌游</text>
  </view>

  <view class="game-grid">
    <view class="game-card" bind:tap="handleSelectAvalon">
      <view class="game-icon avalon-icon">🏰</view>
      <text class="game-name">阿瓦隆</text>
      <text class="game-desc">5-10人 阵营推理</text>
    </view>

    <view class="game-card" bind:tap="handleSelectSgs">
      <view class="game-icon sgs-icon">⚔️</view>
      <text class="game-name">三国杀</text>
      <text class="game-desc">5-10人 身份推理</text>
    </view>
  </view>
</view>
