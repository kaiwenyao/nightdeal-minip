page {
  background: var(--color-bg);
}

.header-card {
  background: var(--color-surface);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-5);
  margin-bottom: var(--space-4);
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: var(--space-4);
  margin-bottom: var(--space-4);
}

.card-title {
  display: block;
  font-size: var(--font-lg);
  font-weight: var(--font-bold);
  color: var(--color-text-primary);
  margin-bottom: var(--space-2);
}

.card-desc {
  display: block;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  margin-top: var(--space-2);
  line-height: 1.65;
}

.clear-btn {
  min-height: 64rpx;
  padding: 0 var(--space-4);
  font-size: var(--font-sm);
  font-weight: var(--font-semibold);
  color: var(--color-accent-dark);
  background: transparent;
  border: 2rpx solid var(--color-accent);
  border-radius: var(--radius-md);
  flex-shrink: 0;
}

.clear-btn--disabled {
  opacity: 0.5;
  color: var(--color-text-muted);
  border-color: var(--color-border);
}

.status-chips {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
}

.chip-primary {
  font-size: var(--font-xs);
  font-weight: var(--font-semibold);
  padding: var(--space-1) var(--space-3);
  border-radius: var(--radius-full);
  color: var(--color-teal);
  background: var(--color-teal-light);
  border: 2rpx solid rgba(15,76,75,0.2);
}

.chip {
  font-size: var(--font-xs);
  font-weight: var(--font-semibold);
  padding: var(--space-1) var(--space-3);
  border-radius: var(--radius-full);
  color: var(--color-text-secondary);
  background: var(--color-bg-warm);
}

.chip-success {
  font-size: var(--font-xs);
  font-weight: var(--font-semibold);
  padding: var(--space-1) var(--space-3);
  border-radius: var(--radius-full);
  color: var(--color-success);
  background: var(--color-success-bg);
  border: 2rpx solid rgba(45,122,95,0.25);
}

.chip--danger {
  font-size: var(--font-xs);
  font-weight: var(--font-semibold);
  padding: var(--space-1) var(--space-3);
  border-radius: var(--radius-full);
  color: var(--color-danger);
  background: var(--color-danger-bg);
  border: 2rpx solid rgba(184,58,58,0.25);
}

.section {
  background: var(--color-surface);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-5);
  margin-bottom: var(--space-4);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-2);
}

.section-title {
  display: block;
  font-size: var(--font-base);
  font-weight: var(--font-bold);
  color: var(--color-text-primary);
  margin-bottom: var(--space-4);
}

.section-header .section-title {
  margin-bottom: 0;
}

.section-desc {
  display: block;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  margin-bottom: var(--space-4);
}

.attack-grid {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.attack-btn {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  padding: var(--space-4) var(--space-5);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  background: var(--color-surface);
  transition: all 200ms ease;
}

.attack-btn-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
}

.attack-name {
  font-size: var(--font-lg);
  font-weight: var(--font-bold);
  color: var(--color-text-primary);
}

.attack-tone {
  font-size: var(--font-xs);
  font-weight: var(--font-semibold);
  padding: var(--space-1) var(--space-3);
  border-radius: var(--radius-full);
  color: var(--color-text-secondary);
  background: var(--color-bg-warm);
}

.attack-reward {
  font-size: var(--font-base);
  font-weight: var(--font-semibold);
  color: var(--color-accent-dark);
}

.attack-desc {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.55;
}

.attack-btn--strike.attack-btn--selected {
  border-color: var(--color-danger);
  background: var(--color-danger-bg);
  box-shadow: 0 8rpx 20rpx rgba(184,58,58,0.14);
}

.attack-btn--strike.attack-btn--selected .attack-name {
  color: var(--color-danger);
}

.attack-btn--strike.attack-btn--selected .attack-tone {
  color: var(--color-danger);
  background: #f8dfdf;
}

.attack-btn--strike.attack-btn--selected .attack-reward {
  color: var(--color-danger);
}

.attack-btn--harass.attack-btn--selected {
  border-color: var(--color-teal);
  background: var(--color-teal-light);
  box-shadow: 0 8rpx 20rpx rgba(15,76,75,0.14);
}

.attack-btn--harass.attack-btn--selected .attack-name {
  color: var(--color-teal);
}

.attack-btn--harass.attack-btn--selected .attack-tone {
  color: var(--color-teal);
  background: #d3ebe9;
}

.attack-btn--harass.attack-btn--selected .attack-reward {
  color: var(--color-teal);
}

.option-grid {
  display: flex;
  gap: var(--space-3);
}

.option-btn {
  flex: 1;
  min-height: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  padding: var(--space-4) var(--space-3);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  background: var(--color-surface);
  transition: all 200ms ease;
}

.option-btn--active {
  background: var(--color-teal);
  border-color: var(--color-teal);
  color: white;
  box-shadow: 0 8rpx 20rpx rgba(15,76,75,0.2);
}

.option-name {
  font-size: var(--font-lg);
  font-weight: var(--font-bold);
  line-height: 1;
  color: var(--color-text-primary);
}

.option-btn--active .option-name {
  color: white;
}

.option-desc {
  font-size: var(--font-xs);
  text-align: center;
  line-height: 1.5;
  color: var(--color-text-secondary);
}

.option-btn--active .option-desc {
  color: rgba(255,255,255,0.9);
}

.verdict-card {
  border-radius: var(--radius-lg);
  border: 2rpx solid;
  padding: var(--space-5);
  margin-bottom: var(--space-4);
}

.verdict-card--success {
  border-color: rgba(45,122,89,0.4);
  background: var(--color-success-bg);
}

.verdict-card--fail {
  border-color: rgba(184,58,58,0.35);
  background: var(--color-danger-bg);
}

.verdict-header {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-2);
}

.verdict-title {
  font-size: var(--font-lg);
  font-weight: var(--font-bold);
}

.verdict-card--success .verdict-title {
  color: var(--color-success);
}

.verdict-card--fail .verdict-title {
  color: var(--color-danger);
}

.verdict-badge {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-base);
  font-weight: var(--font-bold);
  color: white;
}

.verdict-card--success .verdict-badge {
  background: var(--color-success);
}

.verdict-card--fail .verdict-badge {
  background: var(--color-danger);
}

.verdict-reward {
  display: block;
  font-size: var(--font-base);
  font-weight: var(--font-semibold);
  margin-bottom: var(--space-2);
}

.verdict-card--success .verdict-reward {
  color: var(--color-success);
}

.verdict-reason {
  display: block;
  font-size: var(--font-sm);
  line-height: 1.65;
  color: var(--color-text-secondary);
}

.matrix {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.matrix-row {
  display: flex;
  gap: var(--space-2);
  align-items: stretch;
}

.matrix-corner {
  width: 108rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-2);
  border-radius: var(--radius-md);
  background: var(--color-bg-warm);
  border: 2rpx solid var(--color-border);
  flex-shrink: 0;
}

.matrix-corner--attack {
  background: var(--color-surface-raised);
}

.matrix-corner-text {
  font-size: var(--font-xs);
  font-weight: var(--font-semibold);
  color: var(--color-text-secondary);
  text-align: center;
  line-height: 1.35;
}

.matrix-col {
  flex: 1;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-2);
  border-radius: var(--radius-md);
  background: var(--color-bg-warm);
  border: 2rpx solid var(--color-border);
}

.matrix-col-name {
  font-size: var(--font-xs);
  font-weight: var(--font-semibold);
  color: var(--color-text-secondary);
  text-align: center;
  line-height: 1.35;
}

.matrix-cell {
  flex: 1;
  min-height: 88rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--space-1);
  padding: var(--space-2);
  border-radius: var(--radius-md);
  border: 2rpx solid var(--color-border);
  transition: all 200ms ease;
}

.matrix-cell--success {
  background: var(--color-success-bg);
  border-color: rgba(45,122,89,0.3);
}

.matrix-cell--fail {
  background: var(--color-danger-bg);
  border-color: rgba(184,58,58,0.25);
}

.matrix-verdict {
  font-size: var(--font-sm);
  font-weight: var(--font-bold);
}

.matrix-cell--success .matrix-verdict {
  color: var(--color-success);
}

.matrix-cell--fail .matrix-verdict {
  color: var(--color-danger);
}

.matrix-reward {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  text-align: center;
  line-height: 1.35;
}

.matrix-cell--active {
  border-color: var(--color-accent);
  border-width: 3rpx;
  box-shadow: var(--shadow-sm);
  background: var(--color-accent-bg);
}

.matrix-cell--active .matrix-verdict {
  color: var(--color-accent-dark);
}

.tips-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.tip-item {
  display: flex;
  gap: var(--space-3);
  align-items: flex-start;
}

.tip-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: var(--radius-full);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-teal-light);
  border: 2rpx solid rgba(15,76,75,0.2);
}

.tip-icon-text {
  font-size: var(--font-sm);
  font-weight: var(--font-bold);
  color: var(--color-teal);
}

.tip-text {
  flex: 1;
  font-size: var(--font-sm);
  line-height: 1.65;
  color: var(--color-text-secondary);
}

.summary-card {
  background: var(--color-surface);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
}

.summary-text {
  display: block;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.65;
}