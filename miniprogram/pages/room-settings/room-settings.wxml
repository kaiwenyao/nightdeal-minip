<navigation-bar title="房间设置" back="{{true}}" color="black" background="#FFF"></navigation-bar>
<scroll-view class="page-shell" scroll-y type="list">

  <ui-card>
    <view class="card-heading">
      <text class="section-title">房间人数</text>
      <text class="players-count">{{playerCount}} / {{maxPlayers}}</text>
    </view>
    <view class="stepper-row">
      <button
        class="stepper-button {{maxPlayers <= minRoomPlayers ? 'stepper-button--disabled' : ''}}"
        disabled="{{maxPlayers <= minRoomPlayers}}"
        hover-class="stepper-button--pressed"
        bindtap="decreaseMax"
      >-</button>
      <text class="stepper-value">{{maxPlayers}}</text>
      <button
        class="stepper-button {{maxPlayers >= maxRoomPlayers ? 'stepper-button--disabled' : ''}}"
        disabled="{{maxPlayers >= maxRoomPlayers}}"
        hover-class="stepper-button--pressed"
        bindtap="increaseMax"
      >+</button>
    </view>
    <text class="hint-text">范围: {{minRoomPlayers}}-{{maxRoomPlayers}}人</text>
  </ui-card>

  <ui-card>
    <view class="card-heading">
      <text class="section-title">角色配置</text>
      <text wx:if="{{gameType !== 'SGS'}}" class="reset-link" bind:tap="handleResetToDefault">恢复默认</text>
    </view>

    <!-- Avalon roles -->
    <block wx:if="{{gameType !== 'SGS'}}">
      <view class="role-group-label">特殊角色</view>
      <view wx:for="{{specialRoleItems}}" wx:key="key" class="role-row">
        <text class="role-name">{{item.label}}</text>
        <switch checked="{{item.enabled}}" data-role="{{item.key}}" bind:change="handleToggleRole" color="#c9a96e" />
      </view>

      <view class="role-group-label">基础角色</view>
      <view wx:for="{{baseRoleItems}}" wx:key="key" class="role-row">
        <text class="role-name">{{item.label}}</text>
        <view class="stepper-row">
          <button
            class="stepper-button {{item.count <= 0 ? 'stepper-button--disabled' : ''}}"
            disabled="{{item.count <= 0}}"
            data-role="{{item.key}}"
            hover-class="stepper-button--pressed"
            bindtap="decreaseBaseRole"
          >-</button>
          <text class="stepper-value">{{item.count}}</text>
          <button
            class="stepper-button {{totalRoles >= maxPlayers ? 'stepper-button--disabled' : ''}}"
            disabled="{{totalRoles >= maxPlayers}}"
            data-role="{{item.key}}"
            hover-class="stepper-button--pressed"
            bindtap="increaseBaseRole"
          >+</button>
        </view>
      </view>
    </block>

    <!-- SGS roles (read-only) -->
    <block wx:if="{{gameType === 'SGS'}}">
      <view class="role-group-label">身份配置（根据人数自动调整）</view>
      <view wx:for="{{sgsRoleItems}}" wx:key="key" class="role-row">
        <view class="role-info">
          <text class="role-name">{{item.label}}</text>
          <text class="role-desc">{{item.desc}}</text>
        </view>
        <text class="stepper-value">×{{item.count}}</text>
      </view>
      <view class="camp-legend">
        <view class="camp-item camp-loyalist">
          <text class="camp-dot"></text>
          <text class="camp-label">主公阵营：主公 + 忠臣</text>
        </view>
        <view class="camp-item camp-rebel">
          <text class="camp-dot"></text>
          <text class="camp-label">反贼阵营：反贼</text>
        </view>
        <view class="camp-item camp-traitor">
          <text class="camp-dot"></text>
          <text class="camp-label">内奸阵营：内奸（独自作战）</text>
        </view>
      </view>
    </block>

    <view class="role-status {{roleMismatch ? 'warning' : 'ok'}}">
      <text>角色总计: {{totalRoles}} / 房间人数: {{maxPlayers}}</text>
      <text wx:if="{{roleMismatch}}" class="status-hint">
        {{totalRoles !== maxPlayers ? '角色配置与房间人数不匹配' : '当前玩家 ' + playerCount + ' 人，' + (playerCount < maxPlayers ? '未满员' : '超出房间人数')}}
      </text>
    </view>
  </ui-card>

  <ui-card>
    <view class="card-heading">
      <text class="section-title">随机座位号</text>
    </view>
    <view class="setting-row">
      <text class="setting-label">开局时随机分配座位号</text>
      <switch checked="{{isRandomSeat}}" bind:change="handleToggleRandomSeat" color="#c9a96e" />
    </view>
    <text class="hint-text">开启后，房主点击"开始游戏"时会随机打乱所有玩家的座位号，再分配角色。</text>
  </ui-card>

  <ui-button
    variant="primary"
    loading="{{saving}}"
    disabled="{{saveBlocked || roleMismatch || saving}}"
    bind:tap="handleSave"
  >
    {{saveBlocked || roleMismatch ? blockReason : '保存设置'}}
  </ui-button>
</scroll-view>
