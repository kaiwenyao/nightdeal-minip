page {
  background: var(--color-bg);
}

.header-card {
  background: var(--color-surface);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-5);
  margin-bottom: var(--space-4);
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: var(--space-4);
  margin-bottom: var(--space-4);
}

.card-title {
  display: block;
  font-size: var(--font-lg);
  font-weight: var(--font-bold);
  color: var(--color-text-primary);
  margin-bottom: var(--space-2);
}

.card-desc {
  display: block;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.55;
  margin-top: var(--space-2);
}

.clear-btn {
  min-height: 64rpx;
  padding: 0 var(--space-4);
  font-size: var(--font-sm);
  font-weight: var(--font-semibold);
  color: var(--color-accent-dark);
  background: transparent;
  border: 2rpx solid var(--color-accent);
  border-radius: var(--radius-md);
  flex-shrink: 0;
}

.clear-btn--disabled {
  opacity: 0.5;
  color: var(--color-text-muted);
  border-color: var(--color-border);
}

.status-chips {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
}

.remind-card {
  background: var(--color-danger-bg);
  border: 2rpx solid rgba(184, 58, 58, 0.3);
  border-radius: var(--radius-lg);
  padding: var(--space-5);
  margin-bottom: var(--space-4);
}

.remind-head {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-3);
}

.remind-tag {
  font-size: var(--font-xs);
  font-weight: var(--font-bold);
  color: var(--color-danger);
  padding: var(--space-1) var(--space-3);
  border-radius: var(--radius-full);
  background: #f8dfdf;
  border: 2rpx solid rgba(184, 58, 58, 0.3);
}

.remind-title {
  font-size: var(--font-base);
  font-weight: var(--font-bold);
  color: var(--color-danger);
}

.remind-body {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.remind-desc {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.65;
}

.remind-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.remind-item {
  display: flex;
  align-items: flex-start;
  gap: var(--space-3);
  background: #fdf6f6;
  border: 2rpx solid rgba(184, 58, 58, 0.16);
  border-radius: var(--radius-sm);
  padding: var(--space-3) var(--space-4);
}

.remind-key {
  flex-shrink: 0;
  font-size: var(--font-xs);
  font-weight: var(--font-bold);
  color: var(--color-danger);
  background: #fbe9e9;
  border-radius: var(--radius-full);
  padding: var(--space-1) var(--space-3);
  margin-top: 2rpx;
}

.remind-val {
  flex: 1;
  min-width: 0;
  font-size: var(--font-sm);
  line-height: 1.65;
  color: var(--color-text-primary);
}

.remind-note {
  font-size: var(--font-xs);
  color: var(--color-text-muted);
  line-height: 1.6;
}

.chip-primary {
  font-size: var(--font-xs);
  font-weight: var(--font-semibold);
  padding: var(--space-1) var(--space-3);
  border-radius: var(--radius-full);
  color: var(--color-teal);
  background: var(--color-teal-light);
  border: 2rpx solid rgba(15, 76, 75, 0.2);
}

.chip-success {
  font-size: var(--font-xs);
  font-weight: var(--font-semibold);
  padding: var(--space-1) var(--space-3);
  border-radius: var(--radius-full);
  color: var(--color-success);
  background: var(--color-success-bg);
  border: 2rpx solid rgba(45, 122, 95, 0.3);
}

.chip {
  font-size: var(--font-xs);
  font-weight: var(--font-semibold);
  padding: var(--space-1) var(--space-3);
  border-radius: var(--radius-full);
  color: var(--color-text-secondary);
  background: var(--color-bg-warm);
}

.section {
  background: var(--color-surface);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-5);
  margin-bottom: var(--space-4);
}

.section-title {
  display: block;
  font-size: var(--font-base);
  font-weight: var(--font-bold);
  color: var(--color-text-primary);
  margin-bottom: var(--space-2);
}

.section-desc {
  display: block;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  margin-bottom: var(--space-4);
}

.suit-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
}

.suit-btn {
  width: calc(50% - var(--space-2));
  min-height: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  background: var(--color-surface);
  transition: all 200ms ease;
  position: relative;
}

.suit-btn--active {
  border-color: var(--color-teal);
  background: var(--color-teal-light);
  box-shadow: 0 4rpx 12rpx rgba(15, 76, 75, 0.12);
}

.suit-symbol {
  font-size: var(--font-3xl);
  font-weight: var(--font-bold);
  line-height: 1;
}

.suit-name {
  font-size: var(--font-sm);
  font-weight: var(--font-medium);
  color: var(--color-text-primary);
}

.suit-btn--active .suit-name {
  color: var(--color-teal);
  font-weight: var(--font-semibold);
}

.suit-check {
  position: absolute;
  top: var(--space-3);
  right: var(--space-3);
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--color-teal);
  display: flex;
  align-items: center;
  justify-content: center;
}

.suit-check-icon {
  font-size: var(--font-xs);
  font-weight: var(--font-bold);
  color: #ffffff;
}

.summary-card {
  background: var(--color-surface);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
}

.summary-text {
  display: block;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.65;
}

.summary-text--complete {
  color: var(--color-success);
  font-weight: var(--font-semibold);
}
