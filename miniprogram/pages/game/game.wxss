page {
  background: var(--color-bg);
}

/* ── Role Card: the centerpiece ── */
.role-card {
  text-align: center;
  padding: var(--space-12) var(--space-8);
  border-radius: var(--radius-xl);
  background: linear-gradient(145deg, #2a2a40, #1a1a2e);
  border: 3rpx solid var(--color-accent-light);
  box-shadow:
    0 8rpx 40rpx rgba(26, 26, 46, 0.3),
    0 0 60rpx rgba(201, 169, 110, 0.08);
  position: relative;
  overflow: hidden;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

/* Revealed state with smooth transition */
.role-card.revealed {
  background: linear-gradient(145deg, #1a1a2e, #0f0f1e);
  box-shadow:
    0 8rpx 40rpx rgba(26, 26, 46, 0.35),
    0 0 80rpx rgba(201, 169, 110, 0.12),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
  animation: card-reveal 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes card-reveal {
  0% { transform: scale(0.95); opacity: 0.7; }
  50% { transform: scale(1.02); opacity: 0.9; }
  100% { transform: scale(1); opacity: 1; }
}

/* Role text entrance animation */
.role-card.revealed .role-text {
  animation: role-reveal 0.6s ease-out 0.2s both;
}

@keyframes role-reveal {
  0% { opacity: 0; transform: translateY(20rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

/* Camp text entrance animation */
.role-card.revealed .camp-text {
  animation: camp-reveal 0.5s ease-out 0.4s both;
}

@keyframes camp-reveal {
  0% { opacity: 0; transform: translateY(10rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

/* Decorative corner ornaments */
.role-card::before,
.role-card::after {
  content: '';
  position: absolute;
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid var(--color-accent-light);
}

.role-card::before {
  top: 16rpx;
  left: 16rpx;
  border-right: none;
  border-bottom: none;
}

.role-card::after {
  bottom: 16rpx;
  right: 16rpx;
  border-left: none;
  border-top: none;
}

/* Inner corner ornaments via wxml elements */
.ornament-tl,
.ornament-br {
  position: absolute;
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid var(--color-accent-light);
}

.ornament-tl {
  top: 16rpx;
  right: 16rpx;
  border-left: none;
  border-bottom: none;
}

.ornament-br {
  bottom: 16rpx;
  left: 16rpx;
  border-right: none;
  border-top: none;
}

/* Hidden state: card back pattern */
.role-card:not(.revealed) {
  background: linear-gradient(145deg, #2a2a40, #1a1a2e);
}

.label {
  display: block;
  color: var(--color-accent);
  font-size: var(--font-sm);
  font-weight: var(--font-medium);
  letter-spacing: 0.12em;
}

.role-text {
  margin-top: var(--space-6);
  display: block;
  font-size: var(--font-2xl);
  font-weight: var(--font-bold);
  color: var(--color-accent-light);
  letter-spacing: 0.06em;
  text-shadow: 0 2rpx 20rpx rgba(201, 169, 110, 0.2);
  transition: opacity 300ms ease, transform 300ms ease;
}

/* Hidden prompt text — subtle tap hint */
.role-card:not(.revealed) .role-text {
  color: rgba(255, 255, 255, 0.4);
  font-size: var(--font-lg);
  font-weight: var(--font-medium);
  text-shadow: none;
  letter-spacing: 0.02em;
}

.camp-text {
  margin-top: var(--space-3);
  display: block;
  color: var(--color-accent);
  font-size: var(--font-base);
  font-weight: var(--font-medium);
  letter-spacing: 0.04em;
}

.seat-text {
  margin-top: var(--space-5);
  display: inline-block;
  color: var(--color-text-muted);
  font-size: var(--font-sm);
  font-weight: var(--font-medium);
  background: rgba(255, 255, 255, 0.05);
  padding: var(--space-2) var(--space-5);
  border-radius: var(--radius-full);
}

/* ── Camp-specific colors ── */
.role-card.revealed.camp-good {
  border-color: rgba(45, 122, 95, 0.5);
  box-shadow:
    0 8rpx 40rpx rgba(26, 26, 46, 0.3),
    0 0 60rpx rgba(45, 122, 95, 0.1);
}

.role-card.revealed.camp-evil {
  border-color: rgba(184, 58, 58, 0.5);
  box-shadow:
    0 8rpx 40rpx rgba(26, 26, 46, 0.3),
    0 0 60rpx rgba(184, 58, 58, 0.1);
}

.role-card.revealed.camp-traitor {
  border-color: rgba(59, 110, 158, 0.5);
  box-shadow:
    0 8rpx 40rpx rgba(26, 26, 46, 0.3),
    0 0 60rpx rgba(59, 110, 158, 0.1);
}

/* ── Game title badge on game page ── */
.game-title-badge {
  display: inline-block;
  font-size: var(--font-xs);
  color: var(--color-accent);
  font-weight: var(--font-medium);
  letter-spacing: 0.06em;
  background: rgba(201, 169, 110, 0.12);
  padding: var(--space-1) var(--space-3);
  border-radius: var(--radius-full);
  margin-bottom: var(--space-4);
}

/* ── Tap hint animation ── */
.tap-hint {
  display: block;
  margin-top: var(--space-4);
  color: rgba(255, 255, 255, 0.25);
  font-size: var(--font-xs);
  letter-spacing: 0.04em;
  animation: tap-hint-fade 2s ease-in-out infinite;
}

@keyframes tap-hint-fade {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

/* ── Player list ── */
.player-row {
  padding: var(--space-3) 0;
  border-bottom: 1rpx solid var(--color-border);
  color: var(--color-text-primary);
  font-size: var(--font-base);
}

.player-row:last-child {
  border-bottom: none;
}

/* ── Role Description ── */
.role-description {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.6;
  padding: var(--space-2) 0;
}

/* ── Camp Hint ── */
.camp-hint {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.6;
  padding: var(--space-2) 0;
}