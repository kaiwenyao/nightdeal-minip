page {
  background: var(--color-bg);
}

.header-card {
  background: var(--color-surface);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-5);
  margin-bottom: var(--space-4);
}

.card-title {
  display: block;
  font-size: var(--font-lg);
  font-weight: var(--font-bold);
  color: var(--color-text-primary);
  margin-bottom: var(--space-2);
}

.card-desc {
  display: block;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  margin-bottom: var(--space-4);
}

.preset-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
}

.preset-btn {
  min-height: 64rpx;
  padding: 0 var(--space-4);
  font-size: var(--font-sm);
  font-weight: var(--font-semibold);
  color: var(--color-accent-dark);
  background: transparent;
  border: 2rpx solid var(--color-accent);
  border-radius: var(--radius-md);
}

.preset-btn--text {
  color: var(--color-accent-dark);
  border-color: transparent;
  background: transparent;
}

.input-card {
  background: var(--color-surface);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-5);
  margin-bottom: var(--space-4);
}

.input-group {
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
}

.input-wrapper {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.input-label {
  font-size: var(--font-sm);
  font-weight: var(--font-medium);
  color: var(--color-text-secondary);
}

.input-field {
  width: 100%;
  height: 88rpx;
  padding: 0 var(--space-4);
  font-size: var(--font-base);
  color: var(--color-text-primary);
  background: var(--color-surface);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  transition: border-color 200ms ease;
}

.input-field--error {
  border-color: var(--color-danger);
}

.input-placeholder {
  color: var(--color-text-muted);
}

.alert {
  padding: var(--space-3) var(--space-4);
  border-radius: var(--radius-md);
  font-size: var(--font-sm);
  line-height: 1.5;
}

.alert--success {
  background: var(--color-success-bg);
  color: var(--color-success);
  border: 2rpx solid rgba(45,122,95,0.3);
}

.alert--warning {
  background: var(--color-accent-bg);
  color: var(--color-accent-dark);
  border: 2rpx solid rgba(201,169,110,0.3);
}

.alert--error {
  background: var(--color-danger-bg);
  color: var(--color-danger);
  border: 2rpx solid rgba(184,58,58,0.3);
}

.alert-text {
  font-size: var(--font-sm);
}

.alert-value {
  font-weight: var(--font-bold);
}

.prob-section {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.prob-label-title {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
}

.prob-bar {
  height: 24rpx;
  border-radius: var(--radius-full);
  overflow: hidden;
  display: flex;
  border: 2rpx solid var(--color-border);
  background: var(--color-surface);
}

.prob-segment {
  height: 100%;
  min-width: 10rpx;
  transition: width 300ms ease;
}

.prob-segment--a {
  background: var(--color-teal);
}

.prob-segment--b {
  background: var(--color-accent);
}

.prob-segment--c {
  background: var(--color-text-muted);
}

.prob-labels {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
}

.prob-label {
  font-size: var(--font-xs);
  font-weight: var(--font-semibold);
  padding: var(--space-1) var(--space-3);
  border-radius: var(--radius-full);
  background: var(--color-bg-warm);
  color: var(--color-text-secondary);
}

.generate-btn {
  width: 100%;
  min-height: 88rpx;
  font-size: var(--font-base);
  font-weight: var(--font-bold);
  color: white;
  background: var(--color-teal);
  border: none;
  border-radius: var(--radius-md);
  margin-top: var(--space-2);
}

.generate-btn[disabled] {
  background: var(--color-border);
  color: var(--color-text-muted);
}

.result-card {
  background: var(--color-surface);
  border: 2rpx solid rgba(15,76,75,0.3);
  border-radius: var(--radius-lg);
  padding: var(--space-5);
  min-height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 300ms ease;
}

.result-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-3);
}

.result-badge {
  font-size: var(--font-xs);
  font-weight: var(--font-semibold);
  padding: var(--space-1) var(--space-3);
  border-radius: var(--radius-full);
  border: 2rpx solid var(--color-teal);
  color: var(--color-teal);
}

.result-value {
  font-size: 80rpx;
  font-weight: var(--font-bold);
  line-height: 1.1;
  color: var(--color-teal);
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
