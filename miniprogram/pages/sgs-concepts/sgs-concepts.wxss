page {
  background: var(--color-bg);
}

.header-card {
  background: linear-gradient(135deg, rgba(201,169,110,0.12), rgba(148,163,184,0.06));
  border: 2rpx solid rgba(201,169,110,0.45);
  border-radius: var(--radius-lg);
  padding: var(--space-5);
  margin-bottom: var(--space-4);
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-3);
}

.badge {
  font-size: var(--font-xs);
  font-weight: var(--font-bold);
  letter-spacing: 0.18em;
  color: var(--color-accent-dark);
  text-transform: uppercase;
}

.chip {
  font-size: var(--font-xs);
  font-weight: var(--font-semibold);
  padding: var(--space-1) var(--space-3);
  border-radius: var(--radius-full);
  border: 2rpx solid var(--color-accent);
  color: var(--color-accent-dark);
}

.header-title {
  display: block;
  font-size: var(--font-xl);
  font-weight: var(--font-bold);
  line-height: 1.3;
  color: var(--color-text-primary);
  margin-bottom: var(--space-2);
}

.header-desc {
  display: block;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.55;
}

.concepts-list {
  margin-bottom: var(--space-4);
}

.concept-card {
  background: var(--color-surface);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-5);
  margin-bottom: var(--space-4);
  transition: border-color 200ms ease, box-shadow 200ms ease;
}

.concept-card--expanded {
  border-color: var(--color-accent);
  box-shadow: var(--shadow-sm);
}

.concept-card--pressed {
  transform: scale(0.99);
}

.concept-main {
  display: flex;
  align-items: center;
  gap: var(--space-4);
}

.concept-icon {
  width: 104rpx;
  height: 104rpx;
  border-radius: var(--radius-lg);
  border: 2rpx solid var(--color-border);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: var(--color-accent-bg);
}

.concept-icon-text {
  font-size: var(--font-2xl);
  font-weight: var(--font-bold);
  color: var(--color-accent-dark);
}

.concept-info {
  flex: 1;
  min-width: 0;
}

.concept-name {
  display: block;
  font-size: var(--font-lg);
  font-weight: var(--font-bold);
  line-height: 1.2;
  margin-bottom: var(--space-2);
  color: var(--color-text-primary);
}

.concept-summary {
  display: block;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.arrow-icon {
  font-size: var(--font-xl);
  color: var(--color-accent-dark);
  flex-shrink: 0;
  transition: transform 200ms ease;
}

.arrow-icon--open {
  transform: rotate(90deg);
}

/* ── Expanded Detail ── */
.concept-detail {
  margin-top: var(--space-5);
  padding-top: var(--space-4);
  border-top: 2rpx dashed var(--color-border-strong);
}

.detail-tag-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-4);
}

.detail-tag {
  font-size: var(--font-xs);
  font-weight: var(--font-semibold);
  padding: var(--space-1) var(--space-3);
  border-radius: var(--radius-full);
  color: var(--color-accent-dark);
  background: var(--color-accent-bg);
  border: 2rpx solid rgba(201,169,110,0.35);
}

.detail-hint {
  font-size: var(--font-xs);
  color: var(--color-text-muted);
}

.rule-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}

.rule-item {
  display: flex;
  align-items: flex-start;
  gap: var(--space-3);
}

.rule-index {
  width: 44rpx;
  height: 44rpx;
  border-radius: var(--radius-full);
  background: var(--color-teal);
  color: #ffffff;
  font-size: var(--font-sm);
  font-weight: var(--font-bold);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.rule-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}

.rule-title {
  display: block;
  font-size: var(--font-base);
  font-weight: var(--font-bold);
  color: var(--color-teal);
  line-height: 1.35;
}

.rule-desc {
  display: block;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.55;
}

.detail-note {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  background: var(--color-surface-raised);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  padding: var(--space-4);
}

.note-label {
  display: block;
  font-size: var(--font-xs);
  font-weight: var(--font-bold);
  letter-spacing: 0.1em;
  color: var(--color-accent-dark);
}

.note-text {
  display: block;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.footer-note {
  background: var(--color-surface);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
}

.footer-text {
  display: block;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}